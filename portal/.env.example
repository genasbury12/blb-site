# The BOSS Business System: environment template.
# Copy to .env.local for local development. NEVER commit real values.
# Production and staging values go in the Vercel project settings (encrypted), not in git or chat.

# ---- App ----
# local | test | staging | production
APP_ENV=local
# Public base URL of the deployment. The domain is an owner decision (D03); do not invent one.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Support contact shown in the app. Required before production (D08).
SUPPORT_CONTACT_EMAIL=

# ---- Supabase (D02, D03) ----
NEXT_PUBLIC_SUPABASE_URL=
# Publishable (anon) key. Safe for the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key. SERVER ONLY. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Stripe (D04, D05) ----
# Must be a TEST key (sk_test_...) until the owner approves live billing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Live mode is refused by the app unless this is exactly "approved-by-owner".
STRIPE_LIVE_MODE_APPROVAL=

# ---- Email: Resend (D16) ----
RESEND_API_KEY=
EMAIL_FROM=
# false until the owner approves sending. When false, emails are logged, not sent.
EMAIL_SENDING_ENABLED=false
# Comma separated addresses that may receive email outside production.
EMAIL_TEST_ALLOWLIST=

# ---- Video: Mux (D03) ----
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY=

# ---- Error reporting: Sentry (D03, optional) ----
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Only needed for source map upload in CI/Vercel builds.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ---- Scheduled jobs ----
CRON_SECRET=

# ---- Feature flags (contract step 7). "true" enables; anything else disables. ----
FEATURE_BILLING=false
FEATURE_COACHING=false
FEATURE_COMMUNITY=false
FEATURE_FEEDBACK=false
FEATURE_ELITE=false
# Public sales pages stay off until copy and policies are approved (Slice 7).
FEATURE_MARKETING_PAGES=false

# ---- Tests only ----
# Postgres used by `npm run test:db` (a throwaway database is created from it).
TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres
